# Local full-stack Compose. Copy to .env.compose and replace placeholders.
# Host-run Spring Boot and Vite keep using .env from .env.example.
# Do not commit real credentials. This file is not the VPS deployment template.

POSTGRES_DB=jobtrackr
POSTGRES_USER=jobtrackr_app
POSTGRES_PASSWORD=replace-with-local-compose-db-password

JWT_SIGNING_KEY=replace-with-a-long-random-local-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAME_SITE=Lax

# Browser origin for the published frontend. Same-origin /api/v1 does not need CORS,
# but keep this aligned with JOBTRACKR_APP_ORIGIN if you ever call the API directly.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18080

# The SPA entrypoint is published here. Backend stays unpublished. Postgres, CV Generation,
# and Gotenberg still publish host ports for the host-run workflow; containers talk over DNS.
JOBTRACKR_PUBLISH_HOST=127.0.0.1
JOBTRACKR_PORT=18080
JOBTRACKR_APP_ORIGIN=http://127.0.0.1:18080

# Production-shaped backend still requires R2 settings to boot. Documents workflows
# need real R2 values; placeholders are enough to start the stack.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=jobtrackr-development
R2_SIGNED_URL_SECONDS=60

CV_GENERATION_SERVICE_TOKEN=replace-with-local-compose-service-token
CV_GENERATION_PROVIDER=gemini
CV_GENERATION_ALLOW_FAKE_PROVIDER=false
CV_GENERATION_PROFILE=local
CV_GENERATION_WORKER_CONCURRENCY=1
CV_GENERATION_REQUEST_TIMEOUT=5m
CV_GENERATION_REQUEST_TIMEOUT_SECONDS=300
GOOGLE_AI_API_KEY=replace-with-gemini-key
CV_GENERATION_MODEL_ID=gemini-3.1-flash-lite
CV_GENERATION_WORKFLOW_VERSION=cv-graph-v2

GOTENBERG_API_TIMEOUT=30s
GOTENBERG_REQUEST_TIMEOUT=35s
GOTENBERG_MAX_RESPONSE_BYTES=15728640
# Host-side Documents fixture conversion uses the published Gotenberg port.
GOTENBERG_PORT=3000
GOTENBERG_BASE_URL=http://localhost:3000

JOBTRACKR_SEED_ENV=dev
