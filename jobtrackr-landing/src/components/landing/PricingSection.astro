---
const apiOrigin =
  import.meta.env.PUBLIC_API_ORIGIN ?? "https://app.jobtrakcr.com";
---

<section
  class="pricing__container [scroll-margin-top:9rem] under-768:[scroll-margin-top:5rem] flex [flex-flow:column_nowrap] justify-center items-center [row-gap:70px] [height:auto] [max-width:1100px] [width:100%] [margin:0_auto_8rem_auto] [padding-bottom:8rem] [border-bottom:1px_solid_var(--color-light-gray)] under-1100:[max-width:90%]"
  id="pricing-section"
>
  <div class="pricing__content-wrapper flex [flex-flow:column_nowrap] justify-center items-center">
    <span class="badge block [max-width:fit-content] [font-size:0.75rem] uppercase text-silver bg-off-white [padding:0.125rem_1.5rem] rounded-pill [border:1px_solid_var(--color-light-gray)]">
      Pricing
    </span>
    <h2 class="section__heading text-center font-display [font-size:2rem] [font-weight:600] [margin-top:0.75rem] under-768:[font-size:1.625rem] [margin:0.75rem_auto_1rem_auto]">
      One clear weekly plan.
    </h2>
    <h3 class="section__description [max-width:100%] text-medium-gray text-center font-text [font-size:1rem] [font-weight:500] under-768:[font-size:0.875rem]">
      Pay for weekly access to JobTrackr and CV Generation.
    </h3>
  </div>
  <div class="pricing-card__wrapper">
    <article class="pricing-card__article flex [flex-flow:column_nowrap] [align-items:start] [justify-content:start] [row-gap:1rem] [max-width:400px] [width:100%] [height:auto] [background-size:cover] [padding:1rem_1.25rem] rounded-card [box-shadow:var(--shadow-site-strong)] pricing-background">
      <h2 class="bg-linear-to-r from-page to-pricing-pink bg-clip-text text-transparent italic font-display text-[2rem]">
        All Included
      </h2>
      <p class="pricing-card__description [margin-top:-0.5rem] text-light-gray [line-height:1.25] [font-size:1rem] under-425:[font-size:0.9rem]">
        Organize your Applications and create role-tailored CVs during paid
        access.
      </p>
      <p class="pricing-card__price [font-size:3rem] [font-weight:500] text-page under-425:[font-size:2.75rem]">
        10.99&euro;
        <span class="pricing-card__price-span [font-size:1.25rem] [font-weight:400] text-off-white under-425:[font-size:1.1rem]">
          /week
        </span>
      </p>
      <div class="pricing-card__separator [width:100%] [height:1px] bg-off-white"></div>
      <ul class="list-none [padding:0_1rem]">
        <li class="[margin-bottom:0.25rem] text-light-gray">
          &checkmark; Applications and Kanban board
        </li>
        <li class="[margin-bottom:0.25rem] text-light-gray">
          &checkmark; Interviews and Documents
        </li>
        <li class="[margin-bottom:0.25rem] text-light-gray">
          &checkmark; Unlimited CV Generation during paid access
        </li>
        <li class="[margin-bottom:0.25rem] text-light-gray">
          &checkmark; 20 saved Generated CVs per Application
        </li>
        <li class="[margin-bottom:0.25rem] text-light-gray">
          &checkmark; Access from your browser
        </li>
        <li class="[margin-bottom:0.25rem] text-light-gray">
          &checkmark; Weekly recurring billing; applicable tax included
        </li>
      </ul>
      <button
        id="subscribe-button"
        type="button"
        data-api-origin={apiOrigin}
        class="cta-btn pricing-cta block [padding:0.5rem_1.5rem] border-none text-accent-darkest [font-weight:500] capitalize bg-accent-main no-underline [box-shadow:var(--shadow-accent-light)] rounded-card [transition:all_300ms_ease] hover:[box-shadow:var(--shadow-accent-strong)] [width:100%] text-center"
      >
        Subscribe
      </button>
      <p
        id="checkout-message"
        role="status"
        aria-live="polite"
        class="text-off-white"
      ></p>
      <p class="pricing-card__signin [align-self:center] text-off-white [font-size:0.85rem]">
        Already have a User?{" "}
        <a
          href="https://app.jobtrakcr.com/auth/login"
          class="text-accent-main [font-weight:700]"
        >
          Sign in
        </a>
      </p>
    </article>
  </div>
</section>

<script>
  const button =
    document.querySelector<HTMLButtonElement>("#subscribe-button")!;
  const message =
    document.querySelector<HTMLParagraphElement>("#checkout-message")!;
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) button.disabled = false;
  });
  button.addEventListener("click", async () => {
    if (button.disabled) return;
    button.disabled = true;
    message.textContent = "";
    try {
      let requestId = sessionStorage.getItem("jobtrackr-checkout-request");
      if (!requestId) {
        requestId = crypto.randomUUID();
        sessionStorage.setItem("jobtrackr-checkout-request", requestId);
      }
      const response = await fetch(
        `${button.dataset.apiOrigin}/api/v1/billing/checkouts`,
        {
          method: "POST",
          headers: { "Idempotency-Key": requestId },
        },
      );
      const body = await response.json();
      if (!response.ok) {
        if (body.code === "CHECKOUT_EXPIRED") {
          sessionStorage.removeItem("jobtrackr-checkout-request");
          button.disabled = false;
          button.click();
          return;
        }
        message.textContent =
          body.message ?? "Checkout is unavailable. Please try again later.";
        button.disabled = false;
        return;
      }
      const url = new URL(body.url);
      if (url.protocol !== "https:" || url.hostname !== "checkout.stripe.com") {
        throw new Error("Invalid Checkout URL");
      }
      window.location.assign(url.href);
    } catch {
      message.textContent = "Could not open Checkout. Please try again.";
      button.disabled = false;
    }
  });
</script>
