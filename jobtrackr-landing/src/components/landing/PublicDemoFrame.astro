<div class="hero__image-wrapper [width:min(1500px,calc(100vw_-_4rem))] [max-width:140%] h-auto overflow-hidden under-1100:[max-width:90%]">
  <figure
    aria-label="JobTrackr Public Demo"
    id="demo-section"
    class="flex justify-center items-center [width:100%] [height:80dvh] [max-height:80dvh] [background-size:cover] [background-position:center] rounded-card hero-background [scroll-margin-top:9rem] [padding:2.5%_0] under-768:[scroll-margin-top:5rem]"
  >
    <div class="demo__browser-shell flex h-full min-h-0 [flex-flow:column_nowrap] [width:95%] bg-page [border:1px_solid_var(--color-light-gray)] [border-radius:20px] overflow-hidden [box-shadow:var(--shadow-cool-strong)]">
      <div
        aria-hidden="true"
        class="demo__browser-bar flex shrink-0 items-center justify-between [height:48px] [padding:0_1.25rem] [background:var(--color-off-white)] [border-bottom:1px_solid_var(--color-light-gray)] text-medium-gray"
      >
        <span class="demo__dots flex [gap:5px]">
          <i class="[width:10px] [height:10px] [border-radius:50%] [background:var(--color-demo-red)]"></i>
          <i class="[width:10px] [height:10px] [border-radius:50%] [background:var(--color-demo-yellow)]"></i>
          <i class="[width:10px] [height:10px] [border-radius:50%] [background:var(--color-demo-green)]"></i>
        </span>
        <span class="demo__address [padding:0.3rem_1rem] bg-page [border:1px_solid_var(--color-light-gray)] rounded-card [font-size:0.8rem]">
          jobtrakcr.com/demo
        </span>
        <span>&orarr;</span>
      </div>
      <iframe
        src="/demo"
        title="JobTrackr Public Demo"
        loading="lazy"
        class="block min-h-0 flex-1 [width:100%] [border:none]"
      ></iframe>
    </div>
  </figure>
</div>
