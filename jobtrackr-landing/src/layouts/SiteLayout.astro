---
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const links = [
  { label: "Home", href: "/#home-section" },
  { label: "Problem", href: "/#problem-section" },
  { label: "Features", href: "/#features-section" },
  { label: "Pricing", href: "/#pricing-section" },
  { label: "FAQ", href: "/#faq-section" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/jobtrackr-favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-shell" aria-label="Primary">
        <a class="brand" href="/#home-section" aria-label="JobTrackr home">
          <img
            src="/assets/jobtrackr-logo.webp"
            width="48"
            height="48"
            alt=""
          />
          <span>JobTrackr</span>
        </a>
        <div class="desktop-links">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
        <div class="nav-actions">
          <a class="sign-in" href="https://app.jobtrakcr.com/auth/login">
            Sign in
          </a>
          <a class="button button-small" href="/#pricing-section">
            Subscribe
          </a>
        </div>
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-links"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>
      <nav id="mobile-links" class="mobile-links" aria-label="Mobile" hidden>
        {links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="https://app.jobtrakcr.com/auth/login">Sign in</a>
        <a href="/#pricing-section">Subscribe</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-identity">
          <img
            src="/assets/jobtrackr-logo.webp"
            width="40"
            height="40"
            alt=""
          />
          <span>JobTrackr</span>
        </div>
        <p>Keep your job search in one place.</p>
        <div class="footer-links">
          <a href="mailto:support@jobtrakcr.com">support@jobtrakcr.com</a>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href="/cancellation-refund/">Cancellation and Refund</a>
        </div>
        <small>© {new Date().getFullYear()} JobTrackr</small>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>(".mobile-links");
      toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
        if (menu) menu.hidden = isOpen;
      });
      menu?.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("a")) {
          menu.hidden = true;
          toggle?.setAttribute("aria-expanded", "false");
          toggle?.setAttribute("aria-label", "Open menu");
        }
      });
    </script>
  </body>
</html>
