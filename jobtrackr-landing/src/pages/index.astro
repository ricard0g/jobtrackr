---
import "../styles/global.css";
---

<!doctype html>

<html
  lang="en"
  class="[font-size:16px] font-text [scroll-behavior:smooth] motion-reduce:[scroll-behavior:auto]"
>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;family=Nunito:ital,wght@0,200..1000;1,200..1000&amp;display=swap"
      rel="stylesheet"
    />
    <link href="/assets/jobtrackr-favicon.png" rel="icon" />
    <title>JobTrackr &mdash; Your job search, organized</title>
    <script defer="" is:inline src="/scripts/landing.js"></script>
    <meta
      content="Track Applications and create role-tailored CVs with a weekly JobTrackr Subscription."
      name="description"
    />
  </head>
  <body class="[width:100vw] [height:auto] overflow-x-hidden bg-page">
    <header class="header__container [width:100%]">
      <!-- Desktop Navbar -->
      <nav class="header__navbar fixed [top:0] [left:50%] [transform:translateX(-50%)] flex [flex-flow:row_nowrap] justify-center items-center [max-width:1100px] [width:100%] [margin:1rem_auto_0_auto] [padding:0.25rem_1.5rem] bg-off-white [border:1px_solid_var(--color-light-gray)] rounded-card [box-shadow:var(--shadow-cool-light)] [z-index:10] under-1100:[max-width:90%] under-768:hidden">
        <ul class="header__outer-list relative flex [flex-flow:row_nowrap] justify-between items-center [width:100%] list-none [padding:0]">
          <li class="logo flex justify-center items-center">
            <img
              alt="JobTrackr logo"
              class="logo-image [width:60px] [height:60px] under-768:[width:40px] under-768:[height:40px]"
              src="/assets/jobtrackr-logo.webp"
            />
            <span class="[font-size:1.25rem] font-display [font-weight:700] [letter-spacing:-0.5px]">
              JobTrackr
            </span>
          </li>
          <li class="header__inner-list-container absolute [left:50%] [transform:translateX(-50%)] [width:40%] under-1100:[width:55%]">
            <ul class="header__inner-list flex [flex-flow:row_nowrap] justify-center items-center [column-gap:0.75rem] list-none [padding:0]">
              <li>
                <a
                  href="#home-section"
                  class="block text-medium-gray no-underline [transition:all_300ms_ease] hover:text-ink hover:no-underline hover:underline"
                >
                  Home
                </a>
              </li>
              <li>
                <a
                  href="#problem-section"
                  class="block text-medium-gray no-underline [transition:all_300ms_ease] hover:text-ink hover:no-underline hover:underline"
                >
                  Problem
                </a>
              </li>
              <li>
                <a
                  href="#features-section"
                  class="block text-medium-gray no-underline [transition:all_300ms_ease] hover:text-ink hover:no-underline hover:underline"
                >
                  Features
                </a>
              </li>
              <li>
                <a
                  href="#pricing-section"
                  class="block text-medium-gray no-underline [transition:all_300ms_ease] hover:text-ink hover:no-underline hover:underline"
                >
                  Pricing
                </a>
              </li>
              <li>
                <a
                  href="#faq-section"
                  class="block text-medium-gray no-underline [transition:all_300ms_ease] hover:text-ink hover:no-underline hover:underline"
                >
                  FAQ
                </a>
              </li>
            </ul>
          </li>
          <li class="flex items-center [gap:1rem]">
            <a
              class="header__sign-in text-dark-gray [font-size:0.875rem] [font-weight:600] no-underline hover:underline focus-visible:[outline:2px_solid_var(--color-accent-dark)] focus-visible:[outline-offset:3px]"
              href="https://app.jobtrakcr.com/auth/login"
            >
              Sign in
            </a>
            <a
              class="cta-btn block [padding:0.5rem_1.5rem] text-accent-darkest [font-weight:500] capitalize bg-accent-main no-underline [box-shadow:var(--shadow-accent-light)] rounded-card [transition:all_300ms_ease] hover:[box-shadow:var(--shadow-accent-strong)]"
              href="#pricing-section"
            >
              Subscribe
            </a>
          </li>
        </ul>
      </nav>
      <!-- Mobile Navbar -->
      <nav
        aria-label="Mobile"
        class="header__navbar-mobile hidden under-768:fixed under-768:[top:0] under-768:[left:50%] under-768:[transform:translateX(-50%)] under-768:flex under-768:[flex-flow:row_nowrap] under-768:justify-center under-768:items-center under-768:[width:95%] under-768:[margin:1rem_auto_0_auto] under-768:[padding:0.25rem_0.75rem] under-768:bg-off-white under-768:[border:1px_solid_var(--color-light-gray)] under-768:rounded-card under-768:[box-shadow:var(--shadow-cool-light)] under-768:[z-index:10]"
      >
        <ul class="header__outer-list relative flex [flex-flow:row_nowrap] justify-between items-center [width:100%] list-none [padding:0]">
          <li class="logo flex justify-center items-center">
            <a
              class="logo__link under-768:flex under-768:justify-center under-768:items-center under-768:[font-size:0.75rem] under-768:no-underline under-768:text-ink"
              href="#home-section"
            >
              <img
                alt="JobTrackr logo"
                class="logo-image [width:60px] [height:60px] under-768:[width:40px] under-768:[height:40px]"
                src="/assets/jobtrackr-logo.webp"
              />
              <span class="[font-size:1.25rem] font-display [font-weight:700] [letter-spacing:-0.5px]">
                JobTrackr
              </span>
            </a>
          </li>
          <li class="header__button-mobile">
            <button
              aria-expanded="false"
              aria-label="Open menu"
              id="mobile-button"
              class="under-768:flex under-768:justify-center under-768:items-center under-768:[border:none] under-768:[background-color:transparent]"
            >
              <svg
                class="lucide lucide-menu-icon lucide-menu"
                fill="none"
                height="28"
                stroke="#000"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="28"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M4 5h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 19h16"></path>
              </svg>
            </button>
            <ul class="header__inner-list-mobile under-768:absolute under-768:flex under-768:[flex-flow:column_nowrap] under-768:[row-gap:0.5rem] under-768:[left:50%] under-768:[transform:translateX(-50%)_translateY(-5%)] under-768:[margin-top:1rem] under-768:[padding:1rem_1.75rem] under-768:[width:95%] under-768:bg-off-white under-768:[border:1px_solid_var(--color-light-gray)] under-768:rounded-card under-768:[box-shadow:var(--shadow-cool-light)] under-768:list-none under-768:[opacity:0] under-768:[pointer-events:none] under-768:[transition:all_250ms_ease-in] under-768:[&.show-inner-list-mobile]:[opacity:1] under-768:[&.show-inner-list-mobile]:[transform:translateX(-50%)_translateY(0)] under-768:[&.show-inner-list-mobile]:[pointer-events:all] under-768:[max-height:calc(100vh_-_100px)] under-768:overflow-y-auto">
              <li class="under-768:[padding:0.9rem_0_0.5rem_0] under-768:[font-size:1.125rem] under-768:text-center under-768:[border-bottom:1px_solid_var(--color-light-gray)]">
                <a
                  href="#home-section"
                  class="under-768:text-ink under-768:no-underline"
                >
                  Home
                </a>
              </li>
              <li class="under-768:[padding:0.9rem_0_0.5rem_0] under-768:[font-size:1.125rem] under-768:text-center under-768:[border-bottom:1px_solid_var(--color-light-gray)]">
                <a
                  href="#problem-section"
                  class="under-768:text-ink under-768:no-underline"
                >
                  Problem
                </a>
              </li>
              <li class="under-768:[padding:0.9rem_0_0.5rem_0] under-768:[font-size:1.125rem] under-768:text-center under-768:[border-bottom:1px_solid_var(--color-light-gray)]">
                <a
                  href="#features-section"
                  class="under-768:text-ink under-768:no-underline"
                >
                  Features
                </a>
              </li>
              <li class="under-768:[padding:0.9rem_0_0.5rem_0] under-768:[font-size:1.125rem] under-768:text-center under-768:[border-bottom:1px_solid_var(--color-light-gray)]">
                <a
                  href="#pricing-section"
                  class="under-768:text-ink under-768:no-underline"
                >
                  Pricing
                </a>
              </li>
              <li class="under-768:[padding:0.9rem_0_0.5rem_0] under-768:[font-size:1.125rem] under-768:text-center under-768:[border-bottom:1px_solid_var(--color-light-gray)]">
                <a
                  href="#faq-section"
                  class="under-768:text-ink under-768:no-underline"
                >
                  FAQ
                </a>
              </li>
              <li class="under-768:[padding:0.9rem_0_0.5rem_0] under-768:[font-size:1.125rem] under-768:text-center under-768:[border-bottom:1px_solid_var(--color-light-gray)]">
                <a
                  class="cta-btn block [padding:0.5rem_1.5rem] text-accent-darkest [font-weight:500] capitalize bg-accent-main no-underline [box-shadow:var(--shadow-accent-light)] rounded-card [transition:all_300ms_ease] hover:[box-shadow:var(--shadow-accent-strong)] under-768:text-ink under-768:no-underline"
                  href="#pricing-section"
                >
                  Subscribe
                </a>
              </li>
              <li class="under-768:[padding:0.9rem_0_0.5rem_0] under-768:[font-size:1.125rem] under-768:text-center under-768:[border-bottom:1px_solid_var(--color-light-gray)] under-768:[border-bottom:none]">
                <a
                  href="https://app.jobtrakcr.com/auth/login"
                  class="under-768:text-ink under-768:no-underline"
                >
                  Sign in
                </a>
              </li>
            </ul>
          </li>
        </ul>
      </nav>
    </header>
    <main>
      <!-- Hero Section -->
      <section
        class="hero__container [scroll-margin-top:9rem] under-768:[scroll-margin-top:5rem] flex [flex-flow:column_nowrap] justify-center items-center [row-gap:70px] [height:auto] [max-width:1100px] [width:100%] [margin:0_auto_8rem_auto] [padding-bottom:8rem] [border-bottom:1px_solid_var(--color-light-gray)]"
        id="home-section"
      >
        <div class="hero__content-wrapper flex [flex-flow:column_nowrap] justify-center items-center [row-gap:0.625rem] [margin-top:18vh] under-1100:[max-width:90%] under-768:[row-gap:1.125rem]">
          <span class="badge block [max-width:fit-content] [font-size:0.75rem] uppercase text-silver bg-off-white [padding:0.125rem_1.5rem] rounded-pill [border:1px_solid_var(--color-light-gray)]">
            SIMPLE AND CLEAR
          </span>
          <h1 class="hero__heading font-display [font-size:3.5rem] [font-weight:500] text-center under-768:[font-size:2.5rem] under-768:[line-height:1.25]">
            Your job search. <br />
            Organized.
          </h1>
          <p class="hero__subheading font-text text-medium-gray [font-size:0.9rem] [font-weight:500] text-center [max-width:600px] under-768:[font-size:0.875rem]">
            Keep every Application in view, from your first submission to the
            final decision. Track your progress and the details that matter in
            one place.
          </p>
          <div class="hero__btn-wrapper flex justify-center items-center [column-gap:1rem] [margin:1.125rem_0] under-768:[flex-flow:column_nowrap] under-768:[row-gap:1rem] under-768:[width:100%]">
            <a
              class="cta-btn hero-cta block [padding:0.5rem_1.5rem] text-accent-darkest [font-weight:500] capitalize bg-accent-main no-underline [box-shadow:var(--shadow-accent-light)] rounded-card [transition:all_300ms_ease] hover:[box-shadow:var(--shadow-accent-strong)] under-768:block under-768:[width:100%] under-768:text-center under-768:[padding:0.75rem_0]"
              href="#pricing-section"
            >
              Subscribe
            </a>
            <a
              class="secondary-btn group/secondary flex justify-center items-center [column-gap:0.25rem] [padding:0.5rem_1.5rem] text-accent-darkest [font-weight:400] capitalize [background-color:transparent] no-underline rounded-card [border:1px_solid_var(--color-silver)] [transition:all_300ms_ease] hover:[box-shadow:var(--shadow-inner-light)] under-768:block under-768:[width:100%] under-768:text-center under-768:[padding:0.75rem_0]"
              href="#features-section"
            >
              <span>How it works</span>
              <span class="secondary-btn-svg [width:0] [height:1rem] [opacity:0] [transition:all_200ms_ease] group-hover/secondary:[width:1rem] group-hover/secondary:[opacity:1] under-768:hidden">
                <svg
                  class="lucide lucide-chevron-down-icon lucide-chevron-down"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="m6 9 6 6 6-6"></path>
                </svg>{" "}
              </span>
            </a>
          </div>
          <div class="hero__social-proof-wrapper flex items-center justify-center [column-gap:0.5rem]">
            <span class="[font-size:1rem] text-dark-gray under-768:[font-size:0.875rem]">
              &checkmark;
            </span>
            <span class="[font-size:1rem] text-dark-gray under-768:[font-size:0.875rem]">
              Applications, Interviews, and Generated CVs in one place.
            </span>
          </div>
        </div>
        <div class="hero__image-wrapper [width:min(1500px,calc(100vw_-_4rem))] [max-width:150%] h-auto overflow-hidden under-1100:[max-width:90%]">
          <figure
            aria-label="JobTrackr Public Demo"
            id="demo-section"
            class="flex justify-center items-center [width:100%] [height:auto] [background-size:cover] [background-position:center] rounded-card hero-background [scroll-margin-top:9rem] [padding:2.5%_0] under-768:[scroll-margin-top:5rem]"
          >
            <div class="demo__browser-shell flex [flex-flow:column_nowrap] [width:95%] bg-page [border:1px_solid_var(--color-light-gray)] [border-radius:20px] overflow-hidden [box-shadow:var(--shadow-cool-strong)]">
              <div
                aria-hidden="true"
                class="demo__browser-bar flex shrink-0 items-center justify-between [height:48px] [padding:0_1.25rem] [background:var(--color-off-white)] [border-bottom:1px_solid_var(--color-light-gray)] text-medium-gray"
              >
                <span class="demo__dots flex [gap:5px]">
                  <i class="[width:10px] [height:10px] [border-radius:50%] [background:var(--color-demo-red)]"></i>
                  <i class="[width:10px] [height:10px] [border-radius:50%] [background:var(--color-demo-yellow)]"></i>
                  <i class="[width:10px] [height:10px] [border-radius:50%] [background:var(--color-demo-green)]"></i>
                </span>
                <span class="demo__address [padding:0.3rem_1rem] bg-page [border:1px_solid_var(--color-light-gray)] rounded-card [font-size:0.8rem]">
                  jobtrakcr.com/demo
                </span>
                <span>&orarr;</span>
              </div>
              <iframe
                src="/demo"
                title="JobTrackr Public Demo"
                loading="lazy"
                class="block [width:100%] [aspect-ratio:16/10] [border:none] under-768:[aspect-ratio:9/16]"
              ></iframe>
            </div>
          </figure>
        </div>
      </section>
      <!-- Problem Explanation Section -->
      <section
        class="problem__container [scroll-margin-top:9rem] under-768:[scroll-margin-top:5rem] flex [flex-flow:column_nowrap] justify-center items-center [row-gap:70px] [height:auto] [max-width:1100px] [width:100%] [margin:0_auto_8rem_auto] [padding-bottom:8rem] [border-bottom:1px_solid_var(--color-light-gray)] under-1100:[max-width:90%]"
        id="problem-section"
      >
        <div class="problem__content-wrapper flex [flex-flow:column_nowrap] justify-center items-center under-990:hidden">
          <span class="badge block [max-width:fit-content] [font-size:0.75rem] uppercase text-silver bg-off-white [padding:0.125rem_1.5rem] rounded-pill [border:1px_solid_var(--color-light-gray)]">
            The problem
          </span>
          <h2 class="section__heading text-center font-display [font-size:2rem] [font-weight:600] [margin-top:0.75rem] under-768:[font-size:1.625rem]">
            How many Applications did you send this week? <br />
            And last week?
          </h2>
        </div>
        <div class="problem__cards-container flex [flex-flow:column_nowrap] justify-center items-center [row-gap:10vh] [width:100%]">
          <figure class="problem__card grid [grid-template-columns:repeat(9,_minmax(0,_1fr))] [grid-template-areas:'content1_content1_content1_content1_animation1_animation1_animation1_animation1_animation1'] [width:100%] [column-gap:1rem] under-990:grid under-990:[grid-template-columns:1fr] under-990:[grid-template-rows:repeat(2,_minmax(0,_1fr))] under-990:[grid-template-areas:'content1'_'animation1'] under-990:[width:100%] under-990:[column-gap:1rem]">
            <div class="problem__card-video-wrapper [grid-area:animation1] flex justify-center items-center [width:100%] [background:linear-gradient(_125deg,_var(--color-off-white)_70%,_var(--color-accent-light)_)] [border:1px_solid_var(--color-light-gray)] [border-radius:20px] [padding:0_3.125rem] under-990:[max-height:300px] under-990:[height:100%]">
              <video
