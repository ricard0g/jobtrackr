                height="460px"
                loop=""
                muted=""
                playsinline=""
                width="800px"
                class="under-990:[scale:1.3] under-990:[max-height:100%] under-990:[height:100%] under-990:[width:400px]"
              >
                <source
                  src="/assets/hoja-calculo-animation-hd_1.mov"
                  type="video/mp4; codecs=hvc1"
                />
                <source
                  src="/assets/hoja-calculo-animation-hd.webm"
                  type="video/webm"
                />
              </video>
            </div>
            <figcaption class="problem__card-content-wrapper [grid-area:content1] flex [flex-flow:column_nowrap] [align-items:start] justify-between [width:100%] [height:100%] [padding:1rem] under-990:items-center under-990:justify-center under-990:[row-gap:1rem]">
              <div class="problem__card-content-top flex [flex-flow:column_nowrap] [justify-content:start] [align-items:start] [row-gap:0.75rem] under-990:items-center under-990:justify-center under-990:[margin-bottom:1.5rem]">
                <span class="badge block [max-width:fit-content] [font-size:0.75rem] uppercase text-silver bg-off-white [padding:0.125rem_1.5rem] rounded-pill [border:1px_solid_var(--color-light-gray)]">
                  The everyday challenge
                </span>
                <h3 class="problem__card-subheading font-display [font-size:1.875rem] [font-weight:500] under-990:[font-size:1.625rem] under-990:text-center">
                  The spreadsheet shuffle
                </h3>
                <p class="problem__card-description [font-size:1rem] text-medium-gray under-990:[font-size:0.875rem] under-990:text-center">
                  Color-coded columns and duplicate tabs make it hard to see
                  what comes next.
                </p>
                <div class="problem__card-btns flex [justify-content:start] items-center [column-gap:0.5rem] [margin-top:0.5rem] under-990:hidden">
                  <a
                    class="cta-btn hero-cta block [padding:0.5rem_1.5rem] text-accent-darkest [font-weight:500] capitalize bg-accent-main no-underline [box-shadow:var(--shadow-accent-light)] rounded-card [transition:all_300ms_ease] hover:[box-shadow:var(--shadow-accent-strong)] under-768:block under-768:[width:100%] under-768:text-center under-768:[padding:0.75rem_0]"
                    href="#pricing-section"
                  >
                    Subscribe
                  </a>
                  <a
                    class="secondary-btn group/secondary flex justify-center items-center [column-gap:0.25rem] [padding:0.5rem_1.5rem] text-accent-darkest [font-weight:400] capitalize [background-color:transparent] no-underline rounded-card [border:1px_solid_var(--color-silver)] [transition:all_300ms_ease] hover:[box-shadow:var(--shadow-inner-light)] under-768:block under-768:[width:100%] under-768:text-center under-768:[padding:0.75rem_0]"
                    href="#features-section"
                  >
                    <span>How it works</span>
                    <span class="secondary-btn-svg [width:0] [height:1rem] [opacity:0] [transition:all_200ms_ease] group-hover/secondary:[width:1rem] group-hover/secondary:[opacity:1] under-768:hidden">
                      <svg
                        class="lucide lucide-chevron-down-icon lucide-chevron-down"
                        fill="none"
                        height="16"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="16"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>{" "}
                    </span>
                  </a>
                </div>
              </div>
              <div class="problem__card-content-bot under-990:flex under-990:justify-center under-990:items-center under-990:[width:100%]">
                <ul class="problem__card-badge-list flex [flex-flow:column_nowrap] [row-gap:0.5rem] list-none [padding:0] under-990:items-center">
                  <li class="problem__card-badge [width:fit-content] bg-off-white [padding:0.375rem_1.25rem] [border:1px_solid_var(--color-light-gray)] rounded-card">
                    <p class="flex [flex-flow:row_nowrap] [justify-content:start] items-center [column-gap:0.5rem] text-dark-gray under-990:[font-size:0.875rem] under-990:text-center">
                      <span>
                        <svg
                          class="lucide lucide-circle-x-icon lucide-circle-x"
                          fill="none"
                          height="16"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          viewBox="0 0 24 24"
                          width="16"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <circle cx="12" cy="12" r="10"></circle>
                          <path d="m15 9-6 6"></path>
                          <path d="m9 9 6 6"></path>
                        </svg>
                      </span>
                      Details scattered across sheets
                    </p>
                  </li>
                  <li class="problem__card-badge [width:fit-content] bg-off-white [padding:0.375rem_1.25rem] [border:1px_solid_var(--color-light-gray)] rounded-card">
                    <p class="flex [flex-flow:row_nowrap] [justify-content:start] items-center [column-gap:0.5rem] text-dark-gray under-990:[font-size:0.875rem] under-990:text-center">
                      <span>
                        <svg
                          class="lucide lucide-frown-icon lucide-frown"
                          fill="none"
                          height="16"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          viewBox="0 0 24 24"
                          width="16"
                          xmlns="http://www.w3.org/2000/svg"
