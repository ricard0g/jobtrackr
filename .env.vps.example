# Standalone VPS Compose. Copy to .env.vps, replace placeholders, and keep the
# real file off Git. This is not host-run .env or local .env.compose.
# Do not commit real credentials. Restrict the real file to owner read/write.

# Immutable release identity. Do not pin a moving branch tag such as main.
JOBTRACKR_RELEASE_TAG=sha-REPLACE_WITH_40_CHAR_COMMIT
JOBTRACKR_FRONTEND_IMAGE=ghcr.io/ricard0g/jobtrackr/frontend:sha-REPLACE_WITH_40_CHAR_COMMIT
JOBTRACKR_BACKEND_IMAGE=ghcr.io/ricard0g/jobtrackr/backend:sha-REPLACE_WITH_40_CHAR_COMMIT
JOBTRACKR_CV_GENERATION_IMAGE=ghcr.io/ricard0g/jobtrackr/cv-generation:sha-REPLACE_WITH_40_CHAR_COMMIT

# Only the frontend is published. docker-compose.vps.yml hardcodes IPv4
# loopback 127.0.0.1. 18080 is an arbitrary high-port default, not a system
# Nginx listen port. Change JOBTRACKR_PORT if another site already uses it.
JOBTRACKR_PORT=18080

# Public browser origin after the host Nginx / Cloudflare edge exists.
# Compose injects CORS_ALLOWED_ORIGINS into the backend; keep it identical
# to JOBTRACKR_PUBLIC_ORIGIN. Same-origin /api/v1 does not need CORS for the
# SPA. Spring already processes X-Forwarded-Proto/Host/For from frontend Nginx.
# Internal Compose DNS (not host ports): postgres:5432, cv-generation:8081,
# gotenberg:3000, backend:8080.
JOBTRACKR_PUBLIC_ORIGIN=https://jobtrackr.example.test
CORS_ALLOWED_ORIGINS=https://jobtrackr.example.test

# Secure cookies for the HTTPS public origin. Do not set ALLOW_INSECURE on the VPS.
JWT_SIGNING_KEY=replace-with-vps-jwt-signing-key-at-least-32-bytes
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SAME_SITE=Lax

# PostgreSQL credentials reach postgres and the backend only.
POSTGRES_DB=jobtrackr
POSTGRES_USER=jobtrackr_app
POSTGRES_PASSWORD=replace-with-vps-db-password

# R2 credentials reach the backend only. Internal Compose DNS is injected by
# docker-compose.vps.yml (postgres, cv-generation, gotenberg, backend).
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-vps-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-vps-r2-secret-access-key
R2_BUCKET=jobtrackr-production
R2_SIGNED_URL_SECONDS=60

# Shared service token reaches backend and CV Generation only.
CV_GENERATION_SERVICE_TOKEN=replace-with-vps-service-token
CV_GENERATION_WORKER_CONCURRENCY=1
CV_GENERATION_REQUEST_TIMEOUT=5m
CV_GENERATION_REQUEST_TIMEOUT_SECONDS=300
CV_GENERATION_MODEL_ID=gemini-3.1-flash-lite
CV_GENERATION_WORKFLOW_VERSION=cv-graph-v2

# Gemini reaches CV Generation only.
GOOGLE_AI_API_KEY=replace-with-vps-gemini-key

GOTENBERG_API_TIMEOUT=30s
GOTENBERG_REQUEST_TIMEOUT=35s
GOTENBERG_MAX_RESPONSE_BYTES=15728640
